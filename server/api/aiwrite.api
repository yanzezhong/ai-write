// ai-write 云同步 API（权威路由描述；实现为手写 go-zero 结构，保持与此文件同步）
// 鉴权：Authorization: Bearer <token>（除 /api/health）
syntax = "v1"

info (
	title:  "ai-write cloud sync"
	author: "yanzezhong"
	desc:   "V1.1 自动分叉模型，见 docs/backend-plan.md"
)

// ---------- S1 ----------

@server (
	prefix: /api
)
service aiwrite-api {
	@handler Health
	get /health returns HealthResp

	@handler Me
	get /me returns MeResp
}

// ---------- S2（已实现） ----------
//
// get    /projects             项目列表（主项目 + forks 概要）
// post   /projects             创建 {name, device}
// delete /projects/:id         软删
// get    /projects/:id/state   轮询 {version, md5, updatedAt, forks}
// post   /projects/:id/pull    全量文本拉取
// post   /projects/:id/push    {baseVersion, baseMd5, device, files} → 快进 | 自动分叉
// post   /projects/:id/resolve {forkId, action: promote|discard}
// post   /devices              设备上报/改名

type (
	HealthResp {
		Ok   bool   `json:"ok"`
		Name string `json:"name"`
		Time string `json:"time"`
	}
	MeResp {
		User string `json:"user"`
		Note string `json:"note"`
	}
)
